---
import Base from "../../layouts/Base.astro";
import { t } from "../../i18n/ui";

const lang = "en";
const copy = t(lang);
---

<Base lang={lang} title={`${copy.brand} — Product`} description={copy.productBody}>
  <main class="section">
    <h2>{copy.productTitle}</h2>
    <p class="section-lead">{copy.productBody}</p>
    <ul class="feature-list">
      <li>
        <h3>{copy.feature1Title}</h3>
        <p>{copy.feature1Body}</p>
      </li>
      <li>
        <h3>{copy.feature2Title}</h3>
        <p>{copy.feature2Body}</p>
      </li>
      <li>
        <h3>{copy.feature3Title}</h3>
        <p>{copy.feature3Body}</p>
      </li>
    </ul>
    <div class="cta-row" style="margin-top: 2.5rem;">
      <a class="btn btn-primary" href={`/${lang}/self-host/`}>{copy.ctaPrimary}</a>
    </div>
  </main>
</Base>
